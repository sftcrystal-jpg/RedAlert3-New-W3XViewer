<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="470" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#202C32" Foreground="#E5ECEE"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <StackPanel Margin="18">
  <TextBlock Name="Target" Foreground="#A9C8C1" TextWrapping="Wrap"/>
  <StackPanel Name="ConditionFields" Visibility="Collapsed">
   <TextBlock Text="模型状态类型" Margin="0,10,0,4"/>
   <ComboBox Name="StateKind"><ComboBoxItem Content="条件状态"/><ComboBoxItem Content="默认状态"/></ComboBox>
   <StackPanel Name="ConditionsPanel">
    <TextBlock Text="触发条件（多个条件用空格分隔）" Margin="0,8,0,4"/>
    <TextBox Name="Conditions"/>
    <DockPanel Margin="0,4,0,0"><Button Name="AppendFlag" Content="加入条件" DockPanel.Dock="Right" Margin="6,0,0,0"/>
     <ComboBox Name="Flags" IsEditable="True" MaxDropDownHeight="220"/></DockPanel>
   </StackPanel>
  </StackPanel>
  <StackPanel Name="ModelFields" Visibility="Collapsed">
   <TextBlock Text="模型资源" Margin="0,10,0,4"/>
   <DockPanel><Button Name="BrowseModel" Content="选择 W3X…" DockPanel.Dock="Right" Margin="6,0,0,0"/>
    <ComboBox Name="Model" IsEditable="True" MaxDropDownHeight="240"/></DockPanel>
  </StackPanel>
  <StackPanel Name="ModuleFields" Visibility="Collapsed">
   <TextBlock Text="新 Draw 的模块 ID" Margin="0,10,0,4"/>
   <TextBox Name="ModuleId"/>
  </StackPanel>
  <StackPanel Name="FxFields" Visibility="Collapsed">
   <TextBlock Text="特效类型" Margin="0,10,0,4"/>
   <ComboBox Name="FxKind" SelectedIndex="0"><ComboBoxItem Content="粒子系统 · ParticleSysBone"/><ComboBoxItem Content="按帧触发 · FXEvent"/></ComboBox>
   <TextBlock Text="特效资源 ID" Margin="0,8,0,4"/>
   <ComboBox Name="FxId" IsEditable="True" MaxDropDownHeight="260" ToolTip="从 fxpreview 选择或直接输入资源 ID"/>
   <TextBlock Name="CatalogStatus" TextWrapping="Wrap" Foreground="#BCCBD0" Margin="0,4,0,0"/>
  </StackPanel>
  <StackPanel Name="BoneFields" Visibility="Collapsed">
   <TextBlock Name="BoneLabel" Text="骨骼挂点" Margin="0,10,0,4"/>
   <ComboBox Name="Bone" IsEditable="True" MaxDropDownHeight="220"/>
  </StackPanel>
  <CheckBox Name="Follow" Content="跟随骨骼" Visibility="Collapsed" IsChecked="True" Margin="0,8,0,0"/>
  <StackPanel Name="FrameFields" Visibility="Collapsed"><TextBlock Text="触发帧（从 0 开始）" Margin="0,8,0,4"/><TextBox Name="Frame" Text="0"/></StackPanel>
  <TextBlock Name="Error" TextWrapping="Wrap" Foreground="#FFD18C" Margin="0,8,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
   <Button Name="Create" Content="添加并预览" IsDefault="True" Background="#7BE1C6" Foreground="#142C27"/>
  </StackPanel>
 </StackPanel>
</Window>
